{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Radar item (reviewed or pending)",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "source_url",
    "published_at",
    "first_seen_at",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "enum": [
        "document",
        "video",
        "small-vlm",
        "agent"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "paper_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "github_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "huggingface_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "significant_update_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    },
    "review": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "score_dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "required": [
        "innovation",
        "openness",
        "compute",
        "reproducibility",
        "extension",
        "commercialization"
      ]
    },
    "parameters": {
      "type": "string"
    },
    "gpu": {
      "type": "string"
    },
    "weights_open": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "training_code_open": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "data_open": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "lora": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "qlora": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "reviewed_by",
          "reviewed_at",
          "innovation",
          "research_opportunity",
          "score_dimensions",
          "score",
          "evidence_urls"
        ],
        "properties": {
          "evidence_urls": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
